# AMD AI League - Match 4: Intelligent Web Information Retrieval
# Environment Configuration Template
# Copy this file to .env to customize your runtime environment.

# ============================================================
# Inference Backend Routing
# Options: amd_cloud_vllm | local_rocm | universal_fallback
# ============================================================
INFERENCE_BACKEND=universal_fallback

# ------------------------------------------------------------
# Mode 1: AMD Developer Cloud (Instinct MI300X vLLM Endpoint)
# ------------------------------------------------------------
AMD_BASE_URL=https://cloud.amd.com/v1
AMD_API_KEY=your_amd_developer_cloud_key
AMD_MODEL=Qwen/Qwen2.5-72B-Instruct
# Alternative high-throughput model: meta-llama/Llama-3.1-70B-Instruct

# ------------------------------------------------------------
# Mode 2: Local AMD ROCm / HIP GPU Runtime
# ------------------------------------------------------------
ROCM_DEVICE=cuda:0
ROCM_MODEL=Qwen/Qwen2.5-3B-Instruct

# ------------------------------------------------------------
# Mode 3: Universal Fallback (Local Ollama, vLLM, or Zero-Setup Extractive)
# ------------------------------------------------------------
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=Qwen/Qwen2.5-7B-Instruct

# ============================================================
# Agent Pipeline & Strictness Parameters
# ============================================================
MAX_SEARCH_RESULTS=5
MAX_RETRIEVAL_HOPS=2
GROUNDING_STRICTNESS_THRESHOLD=0.35
REQUEST_TIMEOUT_SECONDS=6
USER_AGENT_ROTATION=true
STREAMLIT_SERVER_PORT=8501
